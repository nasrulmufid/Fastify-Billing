# Root .env for docker-compose
# Used for all services in Docker Compose setup

# MySQL Configuration
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root_acak_dan_panjang

# Database User (fasty-api service)
DB_USER=dev
DB_PASSWORD=ganti_dengan_password_database_acak_dan_panjang

# JWT Authentication
JWT_SECRET=ganti_dengan_jwt_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=8h

# Encryption Key for sensitive data
ENCRYPTION_KEY=ganti_dengan_kunci_enkripsi_32_karakter

# CORS Origin
CORS_ORIGIN=http://localhost

# Frontend API URL (fasty-bill service)
VITE_API_URL=/api

# Payment Gateway (SumoPod)
SUMODOP_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMODOP_API_KEY=
SUMODOP_WEBHOOK_SECRET=
SUMODOP_WEBHOOK_TOKEN=

# GenieACS (TR-069 ACS)
GENIEACS_BASE_URL=
GENIEACS_API_KEY=

# WhatsApp Gateway (Baileys)
# NOTE: Baileys integration removed external gateway
# QR login configured via dashboard only
# Credentials auto-generated in .baileys/ volume
# Legacy Go WhatsApp config below (deprecated but kept for reference)
# WA_BASIC_AUTH=admin:ganti_dengan_password_gateway_kuat
# WA_WEBHOOK=
# WA_WEBHOOK_SECRET=ganti_dengan_webhook_secret_acak

# Security Notes:
# - NEVER commit .env file to git
# - Use strong random values: openssl rand -base64 32
# - Min 32 chars for JWT_SECRET, ENCRYPTION_KEY
# - Min 16 chars for DB passwords in production
# - Rotate secrets regularly on production deployment
