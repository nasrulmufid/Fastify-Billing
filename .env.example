# Root .env for docker-compose
# Used for all services in Docker Compose setup

# MySQL Configuration
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root_acak_dan_panjang

# Database User (fasty-api service)
DB_USER=dev
DB_PASSWORD=ganti_dengan_password_database_acak_dan_panjang

# JWT Authentication
JWT_SECRET=ganti_dengan_jwt_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=8h

# Encryption Key for sensitive data
ENCRYPTION_KEY=ganti_dengan_kunci_enkripsi_32_karakter

# CORS Origin
CORS_ORIGIN=http://localhost

# Frontend API URL (fasty-bill service)
VITE_API_URL=/api

# Payment Gateway (SumoPod)
SUMOPOD_URL=https://api-pay-sandbox.sumopod.com
SUMODOP_API_KEY=ganti_dengan_sumopod_api_key
SUMODOP_WEBHOOK_SECRET=ganti_dengan_sumopod_webhook_secret
SUMODOP_WEBHOOK_TOKEN=ganti_dengan_sumopod_webhook_token

# GenieACS (TR-069 ACS)
GENIEACS_BASE_URL=
GENIEACS_API_KEY=

# WhatsApp Gateway (GOWA)
# GOWA runs as docker-compose service; QR/pairing stays in Billing dashboard.
GOWA_BASIC_AUTH=admin:ganti_password_gowa_acak
GOWA_DEVICE_ID=fasty-billing

