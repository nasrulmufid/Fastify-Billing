# ============================================================
# Contoh environment variables untuk docker-compose.yml
# Salin ke .env dan ubah nilai rahasia sebelum deploy!
# ============================================================

# --- Database MySQL ---
MYSQL_ROOT_PASSWORD=changeme_root
DB_NAME=fasty_bill
DB_USER=fasty
DB_PASS=changeme_db

# --- Backend (fasty-api) ---
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost
ENCRYPTION_KEY=ganti_dengan_encryption_key_32_karakter
SUMODOP_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMODOP_WEBHOOK_SECRET=
SUMODOP_WEBHOOK_TOKEN=

# --- Frontend (fasty-bill) ---
# Path/URL API yang dipanggil browser. Gunakan /api (default) agar
# diteruskan nginx ke backend. Atau isi domain penuh jika terpisah.
VITE_API_URL=/api

# --- WhatsApp Gateway ---
# Format: user:password (Basic Auth dashboard & API gateway)
WA_BASIC_AUTH=admin:ganti_password_kuat
# Webhook ke backend (isi bila ada endpoint penerima pesan masuk)
WA_WEBHOOK=
WA_WEBHOOK_SECRET=secret
