# Copy to .env before running docker compose.
# Never commit real secrets.
# Generate secrets with: openssl rand -base64 32

# Database
DB_USER=fasty
DB_PASSWORD=replace_with_strong_random_database_password
DB_NAME=fasty_bill
MYSQL_ROOT_PASSWORD=replace_with_strong_random_root_password

# API runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
JWT_SECRET=replace_with_random_jwt_secret_minimum_32_bytes
JWT_EXPIRES_IN=8h
ENCRYPTION_KEY=replace_with_random_encryption_key_minimum_32_bytes

# Browser origin(s), comma-separated. No wildcard with credentials.
CORS_ORIGIN=https://billing.example.com

# Frontend build-time API path. Keep /api when nginx proxies backend.
VITE_API_URL=/api

# SumoPod
SUMOPOD_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_BASE_URL=
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=replace_with_sumopod_webhook_secret
SUMOPOD_WEBHOOK_TOKEN=replace_with_sumopod_webhook_token

# GenieACS. Optional.
GENIEACS_BASE_URL=
GENIEACS_API_KEY=

# GOWA / WhatsApp
GOWA_BASE_URL=http://gowa:3000
WA_BASIC_AUTH=replace_with_username_and_strong_password
WA_WEBHOOK_SECRET=replace_with_random_webhook_secret
GOWA_BASE_URL=http://gowa:3000
GOWA_DEVICE_ID=fasty-billing
