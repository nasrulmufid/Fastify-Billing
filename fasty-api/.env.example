# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password_min_16_chars
DB_NAME=fasty_bill

# JWT Authentication
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_bytes_random
JWT_EXPIRES_IN=8h

# Encryption Key for sensitive data
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_min_32_bytes_random

# CORS Origin (comma-separated)
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# SumoPod Payment Gateway
SUMODOP_BASE_URL=https://api-pay.sumopod.com
SUMODOP_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
SUMODOP_WEBHOOK_TOKEN=whtok_your_webhook_token

# GenieACS (TR-069 ACS)
GENIEACS_BASE_URL=http://localhost:7557
GENIEACS_API_KEY=your_genieacs_api_key

# Security Notes:
# - NEVER commit .env file to git
# - Rotate all secrets on production deployment
# - Use strong random values (min 32 bytes for secrets)
# - JWT_SECRET, ENCRYPTION_KEY, DB_PASSWORD must be 16+ chars in production
