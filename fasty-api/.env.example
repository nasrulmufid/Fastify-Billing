# Local API development environment.
# Copy to fasty-api/.env. Never commit real secrets.
# Generate secrets with: openssl rand -base64 32

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fasty_bill
DB_USER=fasty
DB_PASSWORD=replace_with_strong_random_database_password

JWT_SECRET=replace_with_random_jwt_secret_minimum_32_bytes
JWT_EXPIRES_IN=8h
ENCRYPTION_KEY=replace_with_random_encryption_key_minimum_32_bytes
CORS_ORIGIN=http://localhost:5173

# SumoPod. Webhook secret or token is required before enabling payment webhooks.
SUMOPOD_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_BASE_URL=
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_WEBHOOK_TOKEN=

# GenieACS. Optional.
GENIEACS_BASE_URL=http://localhost:7557
GENIEACS_API_KEY=

# GOWA / WhatsApp
GOWA_BASE_URL=http://localhost:3000
GOWA_BASIC_AUTH=replace_with_username_and_strong_password
GOWA_DEVICE_ID=fasty-billing

# GOWA webhook signing secret
WA_WEBHOOK_SECRET=replace_with_random_webhook_secret

# Used by migration scripts that connect as MySQL root.
MYSQL_ROOT_PASSWORD=replace_with_strong_random_root_password
