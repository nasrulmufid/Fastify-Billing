# CORS (origin frontend)
CORS_ORIGIN=http://localhost:5173

# SumoPod payment gateway
SUMODOP_BASE_URL=https://api-pay.sumopod.com
SUMODOP_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
SUMODOP_WEBHOOK_TOKEN=whtok_xxxxxxxxxxxx

# Enkripsi secret di DB (32-byte key, base64)
ENCRYPTION_KEY=base64-key-32-bytes-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
