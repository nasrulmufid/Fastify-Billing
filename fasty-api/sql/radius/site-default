# ============================================================
# Site "default" FreeRADIUS — PPPoE untuk Mikrotik NAS.
# Terminate PP-PD, aktifkan sql untuk auth+acct+post-auth.
# ============================================================
server default {

listen {
    type = auth
    ipaddr = *
    port = 0
}

listen {
    type = acct
    ipaddr = *
    port = 0
}

listen {
    type = coa
    ipaddr = *
    port = 3799
}

authorize {
    filter_username
    preprocess
    chap
    mschap
    suffix
    eap {
        ok = return
    }
    files
    -sql
    expiration
    logintime
}

authenticate {
    Auth-Type CHAP {
        chap
    }
    Auth-Type MS-CHAP {
        mschap
    }
    eap
}

preacct {
    preprocess
    acct_unique
    suffix
}

accounting {
    detail
    -sql
    exec
}

post-auth {
    -sql
    Post-Auth-Type REJECT {
        -sql
    }
}

pre-proxy {
}

post-proxy {
    eap
}
}
